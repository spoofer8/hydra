# -----------------------------------------------------------------------------
# Hydra Launcher client env
# -----------------------------------------------------------------------------
# For a self-hosted build, point every URL at your own server (built from
# ./server). See ./server/SELF_HOSTING.md for the deploy walkthrough.
#
# Example values assume you deployed the server behind Caddy at
# https://api.your-domain.com.
# -----------------------------------------------------------------------------

# Core API — every /profile, /users, /games, /catalogue call goes here.
MAIN_VITE_API_URL=https://api.your-domain.com

# Web page opened in the OS browser for sign-in / sign-up. The self-host
# server serves the login HTML at /auth/signin and /auth/signup.
MAIN_VITE_AUTH_URL=https://api.your-domain.com/auth/

# Analytics endpoint. Self-host doesn't collect analytics — point it at the
# main API and it will 404 harmlessly, or leave blank if the client tolerates
# an empty value.
MAIN_VITE_ANALYTICS_API_URL=https://api.your-domain.com

# Checkout URL. In self-host mode there is no checkout — every user is
# permanently "subscribed". This URL only opens if a user clicks the "manage
# subscription" button; a 404 is fine.
MAIN_VITE_CHECKOUT_URL=https://api.your-domain.com/subscription

# External resources URL used for a few auxiliary asset lookups. Point at your
# server; missing assets 404 without breaking the app.
MAIN_VITE_EXTERNAL_RESOURCES_URL=https://api.your-domain.com/resources

# Nimbus is Hydra's original hoster-unlock service (VikingFile links etc).
# Self-host does not proxy hoster services; leave this pointing at the main
# API and hoster unlock will simply be unavailable in the client.
MAIN_VITE_NIMBUS_API_URL=https://api.your-domain.com

# Optional: subdomain to serve a version-pinned UI from. Leave blank to use
# the bundled UI shipped in the installer.
MAIN_VITE_LAUNCHER_SUBDOMAIN=

# --- Renderer-side referral codes (unused in self-host, keep blank) ---
RENDERER_VITE_REAL_DEBRID_REFERRAL_ID=
RENDERER_VITE_TORBOX_REFERRAL_CODE=
