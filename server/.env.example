# Bind address and port. In docker-compose we bind to 0.0.0.0 inside the container.
HOST=0.0.0.0
PORT=8080

# Public origin the client will use to reach the API. Include scheme.
# Used to construct absolute URLs for uploaded avatars, banners, and save downloads.
PUBLIC_URL=https://api.example.com

# Where SQLite lives + where uploads are stored. Mount /data as a volume.
DATA_DIR=/data

# JWT signing key. Generate with: openssl rand -hex 64
# NEVER commit the real value.
JWT_SECRET=change-me-to-64-random-hex-chars

# Access token lifetime (seconds). Default 1h. Refresh tokens live 30 days.
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

# Max upload size in bytes for saves (default 512 MiB) and for avatars/banners (default 16 MiB).
MAX_SAVE_UPLOAD_BYTES=536870912
MAX_ASSET_UPLOAD_BYTES=16777216

# If true, POST /auth/register is enabled. Set to false after you and your
# friends have signed up, or use bin/create-user.ts to seed accounts.
ALLOW_REGISTRATION=true

# Comma-separated CORS origins allowed to hit the API (client uses electron:// so
# usually you only need this for browsing profile pages in a browser).
CORS_ORIGINS=*
